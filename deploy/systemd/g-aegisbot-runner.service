# Install (as root):  cp deploy/systemd/*.service /etc/systemd/system/ && systemctl daemon-reload
#                     systemctl enable --now g-aegisbot-runner
[Unit]
Description=G-Aegisbot trading runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aegis
Group=aegis
WorkingDirectory=/opt/g-aegisbot
EnvironmentFile=/opt/g-aegisbot/.env
ExecStart=/opt/g-aegisbot/.venv/bin/python -m g_aegisbot.engine.runner
Restart=always
RestartSec=10
TimeoutStopSec=60
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/g-aegisbot/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
