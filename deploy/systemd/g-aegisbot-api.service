[Unit]
Description=G-Aegisbot dashboard API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aegis
Group=aegis
WorkingDirectory=/opt/g-aegisbot
EnvironmentFile=/opt/g-aegisbot/.env
ExecStart=/opt/g-aegisbot/.venv/bin/uvicorn --factory g_aegisbot.api.app:create_app_from_env --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/g-aegisbot/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
