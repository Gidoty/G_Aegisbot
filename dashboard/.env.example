# Public values only (they are visible in the browser). Never put the Supabase service key or any
# exchange secret here. Copy to .env.local for development; set the same in Vercel project settings.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable / anon key>
