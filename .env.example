# Copy to .env and fill in. Never commit .env.
# Generate a key:  python -m g_aegisbot.security.crypto
# Comma-separated list for rotation: newest key FIRST (used to encrypt), older keys after (decrypt only).
# This key lives on the VPS only. Do not put it in Vercel.
AEGIS_MASTER_KEYS=

# Local development:
AEGIS_DATABASE_URL=sqlite:///./data/aegisbot.db
# Production (Supabase Postgres, use the direct connection or session pooler from the VPS):
# AEGIS_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ---- API (dashboard backend). Run: uvicorn --factory g_aegisbot.api.app:create_app_from_env --host 127.0.0.1 --port 8000
# Supabase login verification. Use ONE of:
#   SUPABASE_URL=https://<project-ref>.supabase.co          (projects with asymmetric JWT signing keys)
#   SUPABASE_JWT_SECRET=<legacy JWT secret>                  (older projects, HS256)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Origins allowed to call the API from a browser, comma separated (your Vercel dashboard URL).
AEGIS_CORS_ORIGINS=
# Set to true only while debugging: serves /api/docs.
AEGIS_API_DOCS=

# ---- NOWPayments billing (leave blank to disable). Sandbox base URL: https://api-sandbox.nowpayments.io/v1
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
SUBSCRIPTION_PRICE_USD=
SUBSCRIPTION_DAYS=30
# Public HTTPS address of this API (NOWPayments calls <this>/api/billing/nowpayments/ipn) and of the dashboard.
AEGIS_PUBLIC_API_URL=
AEGIS_DASHBOARD_URL=
